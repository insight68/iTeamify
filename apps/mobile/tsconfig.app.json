{
  "extends": "@teamify/tsconfig/base.json",
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "env.d.ts",
    "test/setup.ts"
  ],
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "moduleResolution": "bundler",
    "noEmit": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
