{
  "name": "@iteamify/desktop",
  "productName": "iteamify",
  "version": "0.1.0",
  "private": true,
  "description": "iteamify Desktop \u2014 the AI-native collaboration system for small teams.",
  "homepage": "https://iteamify.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/iteamify/aurocreator.git",
    "directory": "apps/desktop"
  },
  "author": {
    "name": "iteamify",
    "email": "support@iteamify.com"
  },
  "license": "UNLICENSED",
  "main": "./out/main/index.js",
  "scripts": {
    "bundle-cli": "node scripts/bundle-cli.mjs",
    "brand-dev-electron": "node scripts/brand-dev-electron.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:staging": "node scripts/dev.mjs --mode staging",
    "build": "electron-vite build",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web",
    "preview": "electron-vite preview",
    "package": "node scripts/package.mjs",
    "package:all": "node scripts/package.mjs --all-platforms --publish never",
    "lint": "eslint .",
    "test": "vitest run",
    "postinstall": "electron-builder install-app-deps",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "electron-updater": "6.8.9",
    "fix-path": "^5.0.0"
  },
  "devDependencies": {
    "@iteamify/core": "workspace:*",
    "@iteamify/eslint-config": "workspace:*",
    "@iteamify/tsconfig": "workspace:*",
    "@iteamify/ui": "workspace:*",
    "@iteamify/views": "workspace:*",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@electron/asar": "3.4.1",
    "@fontsource-variable/inter": "^5.2.5",
    "@fontsource-variable/source-serif-4": "^5.2.9",
    "@fontsource/geist-mono": "^5.2.7",
    "@tailwindcss/vite": "^4",
    "@tanstack/react-query": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "44.6.0",
    "electron-builder": "26.15.3",
    "electron-vite": "^5.0.0",
    "globals": "^16.0.0",
    "jsdom": "catalog:",
    "lucide-react": "catalog:",
    "motion": "^12.38.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router-dom": "7.18.4",
    "shadcn": "^4.1.0",
    "sonner": "^2.0.7",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "yaml": "2.9.0",
    "zustand": "catalog:"
  }
