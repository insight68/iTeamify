# === Frontend Dev Server ===
FRONTEND_PORT=3000
FRONTEND_ORIGIN=http://localhost:3000

# === API Backend ===
# Backend API base URL. Next.js rewrites /api/* to this target.
# For local dev with a remote backend, set to the remote URL.
# For local backend, leave as http://localhost:8080.
API_URL=http://localhost:8080

# === Web (Next.js) — NEXT_PUBLIC_* vars are inlined at build time ===
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_WS_URL=

# === Desktop (electron-vite) — VITE_* vars are inlined at build time ===
VITE_API_URL=
VITE_WS_URL=
VITE_APP_URL=

# === Production Build ===
# Set to "true" for standalone output (Docker/self-hosted deployments).
# STANDALONE=true

# === Dev CORS ===
# Comma-separated origins for cross-origin HMR (e.g. Tailscale IPs).
# CORS_ALLOWED_ORIGINS=
