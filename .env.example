# === Frontend Dev Server ===
FRONTEND_PORT=3000
FRONTEND_ORIGIN=http://localhost:3000

# === API Backend ===
# Backend API base URL. Next.js rewrites /api/* to this target.
# For local dev with a remote backend, set to the remote URL.
# For local backend, leave as http://localhost:8080.
API_URL=http://localhost:8080

# === Web (Next.js) — NEXT_PUBLIC_* vars are inlined at build time ===
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_WS_URL=

# === Production Build ===
# Set to "true" for standalone output (Docker/self-hosted deployments).
# STANDALONE=true

# === Dev CORS ===
# Comma-separated origins for cross-origin HMR (e.g. Tailscale IPs).
# CORS_ALLOWED_ORIGINS=

# Task-scoped public web search provider key.
ITEAMIFY_WEB_RETRIEVAL_SEARCH_API_KEY=

# Optional shared OpenAgent runtime; model configuration belongs to workspace Settings.
# ITEAMIFY_MANAGED_DAEMON_ID=00000000-0000-4000-8000-000000000001
# ITEAMIFY_MANAGED_DAEMON_SERVICE_TOKEN=<independent-token-at-least-32-characters>
# Backend only: stable base64 key encoding exactly 32 bytes.
# ITEAMIFY_OPENAGENT_SECRET_KEY=<private-workspace-credential-encryption-key>
